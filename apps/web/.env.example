# Copy to .env.local and adjust for your environment.

NEXT_PUBLIC_API_BASE_URL=https://mednexa-api-dev.salmoncoast-083126b7.centralus.azurecontainerapps.io

# Required: PUT /notes/{id}/sign — must match public.users.user_id
NEXT_PUBLIC_SIGNING_USER_ID=<USER_ID_FROM_USERS_TABLE>

# Optional: POST /visits (if you pin a default provider)
NEXT_PUBLIC_PROVIDER_ID=

